# Backend Environment Configuration
APP_ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=https://ameydongre10.github.io,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Processed Artifact Paths (Defaults relative to repository root)
INVENTORY_PATH=data/processed/dataset_inventory.json
ARTIST_INTEL_PATH=data/processed/artist_intelligence.jsonl
MEDIA_LOG_PATH=data/processed/media_selection_log.json
HIRER_INTEL_PATH=data/processed/hirer_intelligence.json
RECOMMENDATIONS_PATH=data/processed/recommendations.json
UPDATED_RECOMMENDATION_PATH=data/processed/updated_recommendation.json

# Frontend Configuration (for GitHub Pages build / local testing)
# Target backend HTTPS API URL on Render:
NEXT_PUBLIC_API_BASE_URL=https://artist-intelligence-api.onrender.com
# Fallback alias supported by frontend build:
VITE_API_URL=https://artist-intelligence-api.onrender.com
# Base path for GitHub Pages project site:
NEXT_PUBLIC_BASE_PATH=/artist-intelligence-recommendation-system
